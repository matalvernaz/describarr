# AudioVault credentials
AUDIOVAULT_EMAIL=your@email.com
AUDIOVAULT_PASSWORD=yourpassword

# Minimum alignment score (0-100) to keep a combined file. Default: 65
DESCRIBARR_MIN_SCORE=65

# Directory for caching downloaded season zips and alignment reports.
# Default: ~/.cache/describarr
# DESCRIBARR_CACHE_DIR=/path/to/cache

# Before overwriting a file in place, hardlink the original aside so a
# mis-accepted alignment can be rolled back. A hardlink is instant and uses
# no extra space until the original content has no other links. Default: on.
# DESCRIBARR_BACKUP_ORIGINALS=true
# Where to keep backups. Unset = a ".describarr_backup" dir beside each file
# (always same-filesystem). Set this to collect them in one place — it must
# be on the SAME filesystem as the media or the hardlink falls back per-file.
# DESCRIBARR_BACKUP_DIR=/path/to/media/.describarr_backup
# Days to keep backups before pruning. 0 = keep forever (manual cleanup).
# DESCRIBARR_BACKUP_RETENTION_DAYS=14

# Optional shared secret for the mutating HTTP endpoints (/hook, /retry,
# /drain, DELETE /queue). Unset = open, relying on docker-network isolation
# (the default). When set, those requests must send a matching X-Api-Key
# header; add it to the Sonarr/Radarr hook scripts (see README). /status stays
# open (it sits behind Traefik SSO).
# DESCRIBARR_API_KEY=change-me

# How many recent accept/reject/skip decisions to keep for the /status audit
# trail. Default: 50. Set 0 to disable the decision log entirely.
# DESCRIBARR_HISTORY_SIZE=50

# How long describarr believes a "no source has an audio description for this"
# result before searching again. Without this memory every /retry?dir= re-runs
# the full search for every episode no catalogue carries. Catalogues do gain
# titles, so the memory expires; a file that changes (an arr re-grab or quality
# upgrade) is searched again immediately regardless, and force=1 on /retry
# overrides it. 0 disables the memory entirely.
# DESCRIBARR_NOMATCH_TTL_DAYS=30

# Extra audio-description sources tried after AudioVault. Comma-separated
# dotted import paths ("module" or "module:factory") to privately-supplied
# provider modules that implement describarr's AudioSource interface (see
# describarr/sources.py). Those modules live outside this repo. Leave unset
# for AudioVault only.
# DESCRIBARR_EXTRA_SOURCES=my_private_source:get_source
