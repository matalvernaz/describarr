# AudioVault credentials
AUDIOVAULT_EMAIL=your@email.com
AUDIOVAULT_PASSWORD=yourpassword

# Minimum alignment score (0-100) to keep a combined file. Default: 65
DESCRIBARR_MIN_SCORE=65

# Directory for caching downloaded season zips and alignment reports.
# Default: ~/.cache/describarr
# DESCRIBARR_CACHE_DIR=/path/to/cache

# Before overwriting a file in place, hardlink the original aside so a
# mis-accepted alignment can be rolled back. A hardlink is instant and uses
# no extra space until the original content has no other links. Default: on.
# DESCRIBARR_BACKUP_ORIGINALS=true
# Where to keep backups. Unset = a ".describarr_backup" dir beside each file
# (always same-filesystem). Set this to collect them in one place — it must
# be on the SAME filesystem as the media or the hardlink falls back per-file.
# DESCRIBARR_BACKUP_DIR=/path/to/media/.describarr_backup
# Days to keep backups before pruning. 0 = keep forever (manual cleanup).
# DESCRIBARR_BACKUP_RETENTION_DAYS=14
